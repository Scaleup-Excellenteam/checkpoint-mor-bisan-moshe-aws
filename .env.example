# Copy to .env beside server.py. Never commit the populated .env.
# Existing process environment values take precedence. Restart after editing.
# Set PYTHON_DOTENV_DISABLED=1 in the test process to bypass .env loading.
# Leave blank until you add your own VirusTotal key locally.
VIRUSTOTAL_API_KEY=
LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434/api/generate
LOCAL_LLM_MODEL=qwen2.5:1.5b
LOCAL_LLM_TIMEOUT_SECONDS=30

# Optional paths: unset database defaults in the project root; log defaults to cwd.
# Relative overrides resolve against the server process working directory.
# CHAT_DATABASE=C:/path/to/chat.db
# CHAT_LOG=C:/path/to/chat.log

URL_REPUTATION_REQUEST_TIMEOUT_SECONDS=10
URL_REPUTATION_CACHE_TTL_SECONDS=86400
URL_REPUTATION_CACHE_MAX_SIZE=512
URL_REPUTATION_MAX_REPORT_AGE_SECONDS=604800
URL_REPUTATION_RATE_LIMIT_PER_MINUTE=4
URL_REPUTATION_COOLDOWN_SECONDS=60
URL_REPUTATION_REVIEW_MALICIOUS_MIN=1
URL_REPUTATION_BLOCK_MALICIOUS_MIN=2
URL_REPUTATION_SUSPICIOUS_REVIEW_MIN=1
# Legacy helper only; integrated policy checks every extracted URL.
URL_REPUTATION_MAX_URLS_PER_MESSAGE=5
# Keep the official endpoint in production; override only in controlled tests.
VIRUSTOTAL_API_BASE_URL=https://www.virustotal.com/api/v3/domains

# Ollama runtime settings must be exported in the terminal running ollama serve.
# The chat server does not configure a separately running Ollama process.
# OLLAMA_HOST=127.0.0.1:11434
# OLLAMA_NO_CLOUD=1
# Server: --host 0.0.0.0 --port 8000; client: --uri ws://127.0.0.1:8000/ws

# Keyless demo (no internet): run `python scripts/demo_services.py`, then either
# export the lines it prints or uncomment these (default port 18080) before
# starting the server. Policy, thresholds and fail-closed behaviour are unchanged;
# only the adapter endpoints point at the loopback fixtures.
# LOCAL_LLM_ENDPOINT=http://127.0.0.1:18080/api/generate
# LOCAL_LLM_MODEL=demo-fixture
# LOCAL_LLM_TIMEOUT_SECONDS=5
# VIRUSTOTAL_API_BASE_URL=http://127.0.0.1:18080/domains
# VIRUSTOTAL_API_KEY=DEMO_ONLY_KEY
# URL_REPUTATION_REQUEST_TIMEOUT_SECONDS=5
# URL_REPUTATION_RATE_LIMIT_PER_MINUTE=100
